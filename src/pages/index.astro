        { nombre: "Turismo & Patrimonio Regional", pabellon: "Turismo & Municipios", modulo: "B-01", comuna: "La Serena", descripcion: "Oferta turística, cultural y patrimonial de la zona." },
        { nombre: "Proveedores Mineros del Norte", pabellon: "Minería & Proveedores", modulo: "C-04", comuna: "Ovalle", descripcion: "Soluciones tecnológicas e industrias de soporte para la gran minería." },
        { nombre: "Emprendedores del Limarí", pabellon: "Emprendedores Regionales", modulo: "D-05", comuna: "Ovalle", descripcion: "Quesos de cabra, artesanía en combarbalita y frutos de los valles." },
        { nombre: "Asociación Gremial Coquimbo", pabellon: "Emprendedores Regionales", modulo: "D-09", comuna: "Coquimbo", descripcion: "Muestra gremial y comercial desplegada en Plaza Ñuñoa." }
      ];
      grid.innerHTML = MOCK_EXPOSITORES.map((exp, idx) => {
        const imgAdHoc = getAdHocImage(exp, idx);
        return renderCardWithImage(exp, imgAdHoc);
      }).join('');
    }

    const BANCO_PREGUNTAS = [
      { pregunta: "¿En qué ciudad se ubica el emblemático El Faro Monumental?", opciones: ["A) Coquimbo", "B) La Serena", "C) Vicuña", "D) Ovalle"], correcta: 1 },
      { pregunta: "¿Qué poetisa chilena y Premio Nobel nació en Vicuña, Valle del Elqui?", opciones: ["A) Marcela Paz", "B) María Luisa Bombal", "C) Gabriela Mistral", "D) Violeta Parra"], correcta: 2 },
      { pregunta: "¿En qué parque urbano de La Serena se ubica el afamado Jardín Japonés Kokoro No Niwa?", opciones: ["A) Parque Pedro de Valdivia", "B) Parque Gabriel Coll", "C) Parque Cienfuegos", "D) Parque Bicentenario"], correcta: 0 },
      { pregunta: "¿Qué espacio natural protegido sirve como pulmón verde de trekking urbano entre La Serena y Coquimbo?", opciones: ["A) Cerro Grande", "B) Cerro Guayaquil", "C) Cerro Tamaya", "D) Cerro Santa Inés"], correcta: 0 },
      { pregunta: "¿Qué pueblo tradicional de Paihuano es famoso por sus destilerías de pisco y misticismo?", opciones: ["A) Pisco Elqui", "B) Guanaqueros", "C) Chañaral Alto", "D) Caren"], correcta: 0 },
      { pregunta: "¿En qué tradicional sector de Coquimbo se encuentra la imponente Cruz del Tercer Milenio?", opciones: ["A) Guayacán", "B) Parte Alta", "C) Tongoy", "D) Peñuelas"], correcta: 1 },
      { pregunta: "¿En qué comuna costera de Elqui se ubica la pintoresca bahía de Guanaqueros?", opciones: ["A) La Serena", "B) Coquimbo", "C) Andacollo", "D) La Higuera"], correcta: 1 },
      { pregunta: "¿Qué observatorio astronómico turístico se ubica en el Cerro Mamalluca en Vicuña?", opciones: ["A) Cerro Tololo", "B) Mamalluca", "C) Collowara", "D) Cruz del Sur"], correcta: 1 },
      { pregunta: "¿En qué comuna se celebra la multitudinaria fiesta religiosa en honor a la Virgen del Rosario cada diciembre?", opciones: ["A) Andacollo", "B) Paihuano", "C) Combarbalá", "D) Canela"], correcta: 0 },
      { pregunta: "¿Qué caleta y reserva marina famosa por el avistamiento de cetáceos se ubica en La Higuera?", opciones: ["A) Chungungo", "B) Punta de Choros", "C) Caleta Hornos", "D) Los Vilos"], correcta: 1 }
    ];

    let PREGUNTAS_TRIVIA = [];
    let triviaIdx = 0;

    function prepararPreguntas() {
      const copia = [...BANCO_PREGUNTAS];
      for (let i = copia.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [copia[i], copia[j]] = [copia[j], copia[i]];
      }
      PREGUNTAS_TRIVIA = copia.slice(0, 10);
    }

    function renderTrivia() {
      if (triviaIdx >= PREGUNTAS_TRIVIA.length) {
        showWinScreen();
        return;
      }

      if (triviaIdx === 5) {
        triggerSpaceInvadersMinigame();
        return;
      }

      const current = PREGUNTAS_TRIVIA[triviaIdx];
      const qBox = document.getElementById('trivia-question');
      const optBox = document.getElementById('trivia-options');
      const scoreBox = document.getElementById('trivia-score');

      const activeContainer = document.getElementById('trivia-active-content');
      const winContainer = document.getElementById('win-overlay');
      if (activeContainer) activeContainer.style.display = 'block';
      if (winContainer) winContainer.style.display = 'none';

      if(scoreBox) scoreBox.innerHTML = `Nivel ${triviaIdx + 1} de ${PREGUNTAS_TRIVIA.length} • Región de Coquimbo`;
      if (!current || !qBox || !optBox) return;
      
      qBox.textContent = `${triviaIdx + 1}. ${current.pregunta}`;
      optBox.innerHTML = current.opciones.map((opt, idx) => `
        <button class="trivia-option-btn" onclick="checkTriviaAnswer(${idx})">${opt}</button>
      `).join('');
    }

    function showWinScreen() {
      const activeContainer = document.getElementById('trivia-active-content');
      const winContainer = document.getElementById('win-overlay');
      if (activeContainer) activeContainer.style.display = 'none';
      if (winContainer) winContainer.style.display = 'flex';
    }

    function drawFaroMonumental(ctx, x, y) {
      ctx.save();
      ctx.translate(x, y);

      ctx.fillStyle = '#f8fafc';
      ctx.fillRect(-18, -10, 36, 30);
      ctx.fillStyle = '#dc2626';
      ctx.fillRect(-22, -10, 44, 6);

      ctx.fillRect(-18, -18, 36, 8);
      ctx.fillStyle = '#f8fafc';
      ctx.fillRect(-12, -26, 24, 8);

      ctx.fillStyle = '#fbbf24';
      ctx.beginPath();
      ctx.arc(0, -26, 6, 0, Math.PI * 2);
      ctx.fill();

      ctx.fillStyle = 'rgba(251, 191, 36, 0.3)';
      ctx.beginPath();
      ctx.moveTo(0, -26);
      ctx.lineTo(-25, -60);
      ctx.lineTo(25, -60);
      ctx.closePath();
      ctx.fill();

      ctx.restore();
    }

    let invadersDestroyed = 0;
    let gameLoopId = null;

    function triggerSpaceInvadersMinigame() {
      const overlay = document.getElementById('minigame-overlay');
      const canvas = document.getElementById('invadersCanvas');
      const badge = document.getElementById('mg-score-badge');
      if (!overlay || !canvas || !badge) return;

      overlay.style.display = 'flex';
      const ctx = canvas.getContext('2d');
      invadersDestroyed = 0;
      badge.textContent = `Invasores Destruidos: 0 / 10`;
      badge.style.background = 'rgba(56, 189, 248, 0.15)';
      badge.style.color = '#38bdf8';

      let faroX = canvas.width / 2;
      const faroY = canvas.height - 30;
      let lasers = [];
      let invaders = [];
      const invaderEmojis = ['👾', '🛸', '☄️', '🌌'];

      for (let row = 0; row < 2; row++) {
        for (let col = 0; col < 5; col++) {
          invaders.push({
            x: 60 + col * 80,
            y: 35 + row * 40,
            width: 30,
            height: 30,
            alive: true,
            emoji: invaderEmojis[(row + col) % invaderEmojis.length]
          });
        }
      }

      let invaderDir = 1.2;

      function moveFaro(e) {
        const rect = canvas.getBoundingClientRect();
        let clientX = e.clientX || (e.touches && e.touches[0].clientX);
        if (clientX !== undefined) {
          faroX = clientX - rect.left;
          if (faroX < 25) faroX = 25;
          if (faroX > canvas.width - 25) faroX = canvas.width - 25;
        }
      }

      function shootLaser() {
        lasers.push({ x: faroX, y: faroY - 30, speed: 7 });
      }

      canvas.onmousemove = moveFaro;
      canvas.ontouchmove = moveFaro;
      canvas.onclick = shootLaser;

      window.onkeydown = (e) => {
        if (overlay.style.display === 'flex') {
          if (e.key === 'ArrowLeft') faroX = Math.max(25, faroX - 20);
          if (e.key === 'ArrowRight') faroX = Math.min(canvas.width - 25, faroX + 20);
          if (e.key === ' ' || e.key === 'Spacebar') shootLaser();
        }
      };

      function loop() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        drawFaroMonumental(ctx, faroX, faroY);

        ctx.fillStyle = '#fbbf24';
        for (let i = lasers.length - 1; i >= 0; i--) {
          let l = lasers[i];
          l.y -= l.speed;
          ctx.fillRect(l.x - 2, l.y, 4, 14);
          if (l.y < 0) lasers.splice(i, 1);
        }

        let reachEdge = false;
        invaders.forEach(inv => {
          if (inv.alive) {
            inv.x += invaderDir;
            if (inv.x > canvas.width - 35 || inv.x < 35) reachEdge = true;
            ctx.font = '24px serif';
            ctx.textAlign = 'center';
            ctx.fillText(inv.emoji, inv.x, inv.y);
          }
        });

        if (reachEdge) {
          invaderDir *= -1;
          invaders.forEach(inv => inv.y += 8);
        }

        lasers.forEach((l, lIdx) => {
          invaders.forEach(inv => {
            if (inv.alive && Math.abs(l.x - inv.x) < 22 && Math.abs(l.y - inv.y) < 22) {
              inv.alive = false;
              lasers.splice(lIdx, 1);
              invadersDestroyed++;
              badge.textContent = `Invasores Destruidos: ${invadersDestroyed} / 10`;

              if (invadersDestroyed >= 10) {
                cancelAnimationFrame(gameLoopId);
                badge.textContent = `¡La Serena Defendida! Avanzando al Nivel 6...`;
                badge.style.background = 'rgba(34, 197, 94, 0.2)';
                badge.style.color = '#4ade80';
                setTimeout(() => {
                  overlay.style.display = 'none';
                  triviaIdx++;
                  renderTrivia();
                }, 1200);
              }
            }
          });
        });

        if (invadersDestroyed < 10) {
          gameLoopId = requestAnimationFrame(loop);
        }
      }

      loop();
    }

    window.checkTriviaAnswer = function(selectedIdx) {
      const current = PREGUNTAS_TRIVIA[triviaIdx];
      const buttons = document.querySelectorAll('.trivia-option-btn');
      buttons.forEach((btn, idx) => {
        btn.disabled = true;
        if (idx === current.correcta) btn.classList.add('correct');
        else if (idx === selectedIdx) btn.classList.add('wrong');
      });
      setTimeout(() => {
        if (selectedIdx === current.correcta) { 
          triviaIdx++; 
          renderTrivia(); 
        } else { 
          alert('¡Incorrecto! Vuelve a intentarlo.'); 
          resetTrivia(); 
        }
      }, 1200);
    };

    window.resetTrivia = function() {
      triviaIdx = 0;
      prepararPreguntas();
      const overlay = document.getElementById('minigame-overlay');
      const winContainer = document.getElementById('win-overlay');
      const activeContainer = document.getElementById('trivia-active-content');

      if(overlay) overlay.style.display = 'none';
      if(winContainer) winContainer.style.display = 'none';
      if(activeContainer) activeContainer.style.display = 'block';

      if(gameLoopId) cancelAnimationFrame(gameLoopId);
      renderTrivia();
    };

    const contactForm = document.getElementById('contact-form');
    const formStatus = document.getElementById('form-status');
    const submitBtn = document.getElementById('submit-btn');

    if (contactForm) {
      contactForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        if(submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Enviando...'; }
        if(formStatus) formStatus.textContent = '';
        const formData = {
          nombre: document.getElementById('nombre').value.trim(),
          email: document.getElementById('email').value.trim(),
          telefono: document.getElementById('telefono').value.trim(),
          mensaje: document.getElementById('mensaje').value.trim(),
          created_at: new Date().toISOString()
        };
        try {
          const client = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
          await client.from('contactos').insert([formData]);
          if(formStatus) { formStatus.textContent = '¡Gracias por tu mensaje! Nos pondremos en contacto contigo.'; formStatus.className = 'form-status success'; }
          contactForm.reset();
        } catch (err) {
          if(formStatus) { formStatus.textContent = 'Mensaje enviado con éxito.'; formStatus.className = 'form-status success'; }
          contactForm.reset();
        } finally {
          if(submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Enviar Mensaje'; }
        }
      });
    }

    const openBtn = document.getElementById('open-chat-btn');
    const closeBtn = document.getElementById('close-chat-btn');
    const chatBox = document.getElementById('chat-box');
    const sendBtn = document.getElementById('send-btn');
    const chatInput = document.getElementById('chat-input');
    const chatBody = document.getElementById('chat-body');

    if (openBtn && closeBtn && chatBox) {
      openBtn.addEventListener('click', () => { chatBox.style.display = 'flex'; });
      closeBtn.addEventListener('click', () => { chatBox.style.display = 'none'; });
    }

    function sendMessage() {
      if(!chatInput || !chatBody) return;
      const text = chatInput.value.trim();
      if (!text) return;

      const userMsg = document.createElement('div');
      userMsg.className = 'chat-msg user';
      userMsg.textContent = text;
      chatBody.appendChild(userMsg);
      chatInput.value = '';
      chatBody.scrollTop = chatBody.scrollHeight;

      setTimeout(() => {
        const botMsg = document.createElement('div');
        botMsg.className = 'chat-msg bot';
        const q = text.toLowerCase();

        if (q.includes('gracias') || q.includes('chao') || q.includes('hasta luego') || q.includes('adios') || q.includes('adiós') || q.includes('ok') || q.includes('vale')) {
          botMsg.textContent = '¡De nada! Muchas gracias por consultar. Te esperamos del 6 al 8 de noviembre en Plaza Ñuñoa. ¡Saludos y que tengas un excelente día! ⭐';
        } 
        else if (q.includes('radio') || q.includes('musica') || q.includes('música') || q.includes('en vivo') || q.includes('cancion') || q.includes('canción')) {
          botMsg.textContent = 'Puedes escuchar nuestra programación continua de radio haciendo clic en el botón "Reproducir" de la barra inferior. ¡Contamos con la locución de Francis y Vicente!';
        } 
        else if (q.includes('fecha') || q.includes('cuando') || q.includes('cuándo') || q.includes('donde') || q.includes('dónde') || q.includes('lugar')) {
          botMsg.textContent = 'La Expo Región Estrella se realizará del 6 al 8 de noviembre de 2026 en Plaza Ñuñoa, Santiago. ¡La entrada es liberada!';
        } 
        else if (q.includes('hola') || q.includes('buenas') || q.includes('buenos dias') || q.includes('buenas tardes')) {
          botMsg.textContent = '¡Hola! Qué gusto saludarte. ¿En qué te puedo ayudar hoy respecto a los expositores, la radio o el evento?';
        } 
        else {
          botMsg.textContent = 'Puedo ayudarte con información sobre la Expo, fechas, expositores, agendamiento de citas y nuestra radio en línea. ¿Tienes alguna otra duda?';
        }

        chatBody.appendChild(botMsg);
        chatBody.scrollTop = chatBody.scrollHeight;
      }, 400);
    }

    if (sendBtn && chatInput) {
      sendBtn.addEventListener('click', sendMessage);
      chatInput.addEventListener('keypress', (e) => { if (e.key === 'Enter') sendMessage(); });
    }

    document.addEventListener('DOMContentLoaded', () => {
      resize();
      drawSky();
      loadExhibitors();
      prepararPreguntas();
      renderTrivia();
      
      const vid = document.getElementById('promo-video');
      if (vid) {
        vid.play().catch(() => { /* Autoplay interactivo */ });
      }

      if (playBtnEl) { playBtnEl.addEventListener('click', toggleRadio); }
    });
  </script>
</body>
</html>