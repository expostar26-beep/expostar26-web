---
---
<!DOCTYPE html>
<html lang="es" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>EXPO REGIÓN ESTRELLA 2026</title>
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>⭐</text></svg>" />
  
  <!-- Tailwind CSS CDN para renderizado inmediato -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#fffbe1',
              400: '#fbbf24',
              500: '#f59e0b',
              600: '#d97706',
            }
          }
        }
      }
    }
  </script>
  
  <!-- Supabase JS Client -->
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col font-sans antialiased selection:bg-amber-500 selection:text-slate-950">

  <!-- Header / Hero Section -->
  <header class="relative overflow-hidden border-b border-slate-800 bg-slate-900/60 py-16 px-6 text-center shadow-2xl backdrop-blur-md">
    <div class="absolute inset-0 bg-gradient-to-r from-amber-500/10 via-purple-500/10 to-blue-500/10 pointer-events-none"></div>
    <div class="relative z-10 max-w-4xl mx-auto space-y-6">
      <span class="inline-block px-4 py-1.5 rounded-full text-xs font-semibold tracking-wider bg-amber-500/10 text-amber-400 border border-amber-500/30 uppercase">
        6 AL 8 DE NOVIEMBRE • PLAZA ÑUÑOA, SANTIAGO
      </span>
      <h1 class="text-4xl sm:text-6xl font-black tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-amber-300 via-amber-400 to-amber-500 uppercase drop-shadow-md">
        EXPO REGIÓN ESTRELLA
      </h1>
      <p class="text-lg sm:text-xl text-slate-300 max-w-2xl mx-auto font-light leading-relaxed">
        La Región de Coquimbo se levanta y despliega lo mejor de sus valles, costas y emprendimientos.
      </p>
      
      <!-- Botones de Acción principales -->
      <div class="pt-4 flex flex-wrap justify-center gap-4">
        <a href="#catalogo" class="px-6 py-3 rounded-xl bg-amber-500 text-slate-950 font-bold hover:bg-amber-400 transition-all transform hover:-translate-y-0.5 shadow-lg shadow-amber-500/20">
          Explorar Pabellones
        </a>
        <a href="https://cal.com" target="_blank" rel="noopener noreferrer" class="px-6 py-3 rounded-xl bg-slate-800 border border-slate-700 hover:border-amber-500/50 hover:bg-slate-700 text-slate-200 font-semibold transition-all">
          Agendar Citas B2B (Cal.com)
        </a>
      </div>
    </div>
  </header>

  <!-- Seccion Principal / Catalogo -->
  <main class="flex-1 max-w-7xl mx-auto w-full px-6 py-12 space-y-12" id="catalogo">
    
    <div class="text-center space-y-2">
      <h2 class="text-3xl font-bold tracking-tight text-slate-100">Catálogo de Expositores</h2>
      <p class="text-slate-400 text-sm">Conoce los módulos participantes de la Región de Coquimbo en Plaza Ñuñoa.</p>
    </div>

    <!-- Grid Dinámico de Expositores -->
    <div id="expositores-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <div class="col-span-full py-16 text-center text-slate-400 animate-pulse bg-slate-900/40 rounded-2xl border border-slate-800">
        <p class="text-lg">Cargando expositores en tiempo real desde Supabase...</p>
      </div>
    </div>

  </main>

  <!-- Footer -->
  <footer class="border-t border-slate-800/80 bg-slate-950 py-8 text-center text-xs text-slate-500">
    <p>© 2026 EXPO REGIÓN ESTRELLA • Gobierno Regional de Coquimbo</p>
  </footer>

  <!-- Widget de Chat Flotante IA -->
  <div id="ai-chat-widget" class="fixed bottom-6 right-6 z-50">
    <button id="chat-toggle" title="Asistente Virtual" class="w-14 h-14 rounded-full bg-gradient-to-r from-amber-500 to-amber-600 text-slate-950 shadow-xl flex items-center justify-center font-bold text-2xl hover:scale-105 transition-all shadow-amber-500/20 border-2 border-amber-300">
      ✨
    </button>
  </div>

  <!-- Script Client-Side para Supabase -->
  <script>
    const SUPABASE_URL = "https://crhbfrqfqgxttzyudvt.supabase.co";
    const SUPABASE_ANON_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImNyaGJmcnFmcWd4dHR6eXVkdnQiLCJyb2xlIjoiYW5vbiIsImlhdCI6MTc0MDIxNjI1MywiZXhwIjoyMDU1NzkyMjUzfQ.S8O3S8L94eY1i4i9n6K5O8u3S8L94eY1i4i9n6K5O8u";

    async function loadExhibitors() {
      const grid = document.getElementById('expositores-grid');
      try {
        const client = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
        const { data: expositores, error } = await client.from('expositores').select('*');

        if (error || !expositores || expositores.length === 0) {
          renderFallback();
          return;
        }

        grid.innerHTML = expositores.map(exp => `
          <div class="bg-slate-900/80 border border-slate-800 hover:border-amber-500/40 rounded-2xl p-6 transition-all duration-300 hover:shadow-xl hover:shadow-amber-500/5 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-semibold text-amber-400 bg-amber-500/10 px-2.5 py-1 rounded-full border border-amber-500/20">
                  ${exp.pabellon || 'Pabellón Coquimbo'}
                </span>
                <span class="text-xs font-mono text-slate-500">Módulo ${exp.modulo || 'A-01'}</span>
              </div>
              <h3 class="text-xl font-bold text-slate-100 hover:text-amber-300 transition-colors mb-2">${exp.nombre}</h3>
              <p class="text-slate-400 text-sm leading-relaxed mb-4">${exp.descripcion || 'Emprendimiento destacado de la Región de Coquimbo.'}</p>
            </div>
            <div class="pt-4 border-t border-slate-800/60 flex items-center justify-between text-xs text-slate-400">
              <span>📍 ${exp.comuna || 'La Serena / Coquimbo'}</span>
              <span class="text-amber-400 font-medium">Módulo Confirmado</span>
            </div>
          </div>
        `).join('');
      } catch (err) {
        renderFallback();
      }
    }

    function renderFallback() {
      const grid = document.getElementById('expositores-grid');
      const MOCK_EXPOSITORES = [
        { nombre: "Pisco Elqui Artesanal", pabellon: "Pisco & Licores", modulo: "A-12", comuna: "Paihuano", descripcion: "Destilados prémium con denominación de origen del Valle del Elqui." },
        { nombre: "Quesos de Majada Ovalle", pabellon: "Agroalimentaria", modulo: "B-05", comuna: "Ovalle", descripcion: "Quesos de cabra madurados con recetas tradicionales del Limarí." },
        { nombre: "Observatorio Astroturismo", pabellon: "Turismo & Astronomía", modulo: "C-01", comuna: "Vicuña", descripcion: "Experiencias de astroturismo bajo los cielos más limpios del planeta." },
        { nombre: "Artesanías en Combarbalita", pabellon: "Artesanía Regional", modulo: "D-08", comuna: "Combarbalá", descripcion: "Piezas únicas talladas en piedra combarbalita nativa." },
        { nombre: "Aceite de Oliva Valle del Huasco/Elqui", pabellon: "Agroalimentaria", modulo: "B-09", comuna: "La Serena", descripcion: "Aceite de oliva extra virgen prensado en frío de alta pureza." },
        { nombre: "Mariscos & Algas Coquimbo", pabellon: "Productos del Mar", modulo: "E-03", comuna: "Coquimbo", descripcion: "Conservas de mariscos y gourmet marino sustentable." }
      ];

      grid.innerHTML = MOCK_EXPOSITORES.map(exp => `
        <div class="bg-slate-900/80 border border-slate-800 hover:border-amber-500/40 rounded-2xl p-6 transition-all duration-300 hover:shadow-xl hover:shadow-amber-500/5 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-semibold text-amber-400 bg-amber-500/10 px-2.5 py-1 rounded-full border border-amber-500/20">${exp.pabellon}</span>
              <span class="text-xs font-mono text-slate-500">Módulo ${exp.modulo}</span>
            </div>
            <h3 class="text-xl font-bold text-slate-100 hover:text-amber-300 transition-colors mb-2">${exp.nombre}</h3>
            <p class="text-slate-400 text-sm leading-relaxed mb-4">${exp.descripcion}</p>
          </div>
          <div class="pt-4 border-t border-slate-800/60 flex items-center justify-between text-xs text-slate-400">
            <span>📍 ${exp.comuna}</span>
            <span class="text-amber-400 font-medium">Módulo Confirmado</span>
          </div>
        </div>
      `).join('');
    }

    document.addEventListener('DOMContentLoaded', loadExhibitors);
  </script>
</body>
</html>
