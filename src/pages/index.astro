    function getAdHocImage(exp, index) {
      if (exp.pabellon === "Minería & Proveedores" || exp.nombre.includes("Mineros")) {
        return "/imagen_aerea.jpeg";
      }
      return GALERIA_EXPOSITORES[index % GALERIA_EXPOSITORES.length];
    }

    async function loadExhibitors() {
      const grid = document.getElementById('expositores-grid');
      if (!grid) return;

      try {
        const client = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
        const { data: expositores, error } = await client.from('expositores').select('*');

        if (error || !expositores || expositores.length === 0) {
          renderFallback();
          return;
        }

        grid.innerHTML = expositores.map((exp, index) => {
          const imgAdHoc = getAdHocImage(exp, index);
          return renderCardWithImage(exp, imgAdHoc);
        }).join('');
