        </div>
      `;
    }

    function renderFallback() {
      const grid = document.getElementById('expositores-grid');
      if (!grid) return;
      const MOCK_EXPOSITORES = [
        { nombre: "Inmobiliaria & Proyectos Coquimbo", pabellon: "Inmobiliaria", modulo: "A-01", comuna: "La Serena", descripcion: "Proyectos habitacionales e inversión inmobiliaria en la costa regional." },
