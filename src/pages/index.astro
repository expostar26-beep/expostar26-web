    let isRadioActive = false;
    let musicIndex = Math.floor(Math.random() * musicPlaylist.length);
    let podcastCounter = 0;
    
    const musicLayer = new Audio();
    const voiceLayer = new Audio();
    musicLayer.volume = 1.0;
    voiceLayer.volume = 1.0;

    const trackNameEl = document.getElementById('radio-track-name');
    const playBtnEl = document.getElementById('radio-play-btn');

    function toggleRadio() {
      if (!isRadioActive) {
        startLiveRadio();
      } else {
        musicLayer.pause();
        voiceLayer.pause();
        isRadioActive = false;
        if (playBtnEl) playBtnEl.textContent = "▶ Reproducir";
        if (trackNameEl) trackNameEl.textContent = "Radio pausada";
      }
    }

    function startLiveRadio() {
      isRadioActive = true;
      if (playBtnEl) playBtnEl.textContent = "⏸ Pausar";
      playNextSmartSequence();
    }

    function playNextSmartSequence() {
      if (!isRadioActive) return;
      const optionsTime = { timeZone: 'America/Santiago', hour: '2-digit', minute: '2-digit', hour12: false };
      const horaActualChile = new Intl.DateTimeFormat('es-CL', optionsTime).format(new Date());

      if (podcastCounter >= 2 && podsPlaylist.length > 0) {
        podcastCounter = 0;
        const pod = podsPlaylist[Math.floor(Math.random() * podsPlaylist.length)];
        if (trackNameEl) trackNameEl.textContent = `🎙️ Locución Radio | ${pod.name} • ${horaActualChile} hrs`;
        fadeVolume(musicLayer, musicLayer.volume, 0.15, 800);
        voiceLayer.src = pod.file;
        voiceLayer.play().then(() => {
          voiceLayer.onended = () => {
            if (!isRadioActive) return;
            fadeVolume(musicLayer, musicLayer.volume, 1.0, 800);
            playNextSmartSequence();
          };
        }).catch(err => {
          fadeVolume(musicLayer, musicLayer.volume, 1.0, 500);
          playNextSmartSequence();
        });
        return;
      }

      const track = musicPlaylist[musicIndex];
      if (trackNameEl) trackNameEl.textContent = `🕒 ${horaActualChile} Chile | Al aire: ${track.name}`;

      musicLayer.src = track.file;
      musicLayer.play().then(() => {
        musicLayer.onended = () => {
          if (!isRadioActive) return;
          podcastCounter++;
          musicIndex = (musicIndex + 1) % musicPlaylist.length;
          playNextSmartSequence();
        };
      }).catch(err => {
        musicIndex = (musicIndex + 1) % musicPlaylist.length;
        playNextSmartSequence();
      });
    }

    function fadeVolume(audioElement, startVol, endVol, duration) {
      let startTime = null;
      audioElement.volume = startVol;
      function step(timestamp) {
        if (!startTime) startTime = timestamp;
        let progress = timestamp - startTime;
        let currentVol = startVol + (endVol - startVol) * (progress / duration);
        if (currentVol < 0) currentVol = 0;
        if (currentVol > 1) currentVol = 1;
        audioElement.volume = currentVol;
        if (progress < duration) requestAnimationFrame(step);
        else audioElement.volume = endVol;
      }
      requestAnimationFrame(step);
    }

    function updateAstroData() {
      const now = new Date();
      const optionsTime = { timeZone: 'America/Santiago', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false };
      const timeStr = new Intl.DateTimeFormat('es-CL', optionsTime).format(now);
      const timeEl = document.getElementById('astro-time-live');
      if(timeEl) timeEl.textContent = `Chile: ${timeStr} hrs (UTC-3)`;

      const constellations = [
        "Escorpión y Sagitario dominando el cenit sobre los valles de Elqui y Limarí.",
        "Cruz del Sur y Centauro visibles en el horizonte austral de la Provincia del Choapa.",
        "El Triángulo de Invierno y Júpiter brillando con máxima intensidad sobre los observatorios de Andacollo."
      ];
      const moonPhases = [
        "Luna Creciente visible en el firmamento costero de La Serena y Coquimbo. Marea favorable para pesca artesanal.",
        "Luna Llena despejada sobre los observatorios científicos de Tololo y Mamalluca. Excelentes condiciones de observación."
      ];
      const dayOfYear = Math.floor((now - new Date(now.getFullYear(), 0, 0)) / (1000 * 60 * 60 * 24));
      const constEl = document.getElementById('astro-constellation');
      const moonEl = document.getElementById('astro-moon-tides');
      if(constEl) constEl.textContent = constellations[dayOfYear % constellations.length];
      if(moonEl) moonEl.textContent = moonPhases[dayOfYear % moonPhases.length];
    }
    setInterval(updateAstroData, 1000);
    updateAstroData();

    const canvas = document.getElementById('starry-sky');
    const ctx = canvas ? canvas.getContext('2d') : null;
    let width, height, stars = [];

    function resize() {
      if(!canvas) return;
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
      initStars();
    }
    function initStars() {
      stars = [];
      const count = Math.floor((width * height) / 9000);
      for (let i = 0; i < count; i++) {
        stars.push({ x: Math.random() * width, y: Math.random() * height, radius: Math.random() * 1.5 + 0.4, alpha: Math.random() * 0.7 + 0.3 });
      }
    }
    function drawSky() {
      if(!ctx || !canvas) return;
      ctx.clearRect(0, 0, width, height);
      stars.forEach(star => {
        ctx.fillStyle = `rgba(255, 255, 255, ${star.alpha})`;
        ctx.beginPath();
        ctx.arc(star.x, star.y, star.radius, 0, Math.PI * 2);
        ctx.fill();
      });
    }
    window.addEventListener('resize', resize);

    const ICONOS_PABELLON = {
      "Inmobiliaria": "🏢",
      "Gastronomía & Pisqueras": "🍷",
      "Turismo & Municipios": "🔭",
