---
import Layout from '../layouts/Layout.astro';
import { createClient } from '@supabase/supabase-js';

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || 'https://vpbpedholrdeuisxaanw.supabase.co';
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '';

let expositores = [];

if (supabaseUrl && supabaseAnonKey) {
  try {
    const supabase = createClient(supabaseUrl, supabaseAnonKey);
    const { data, error } = await supabase.from('expositores').select('*');
    if (data && !error) {
      expositores = data;
    }
  } catch (e) {
    console.error("Error al conectar con Supabase durante la compilación:", e);
  }
}
---

<Layout title="EXPO REGIÓN ESTRELLA 2026 | Coquimbo en Plaza Ñuñoa">
  <main class="min-h-screen bg-slate-950 text-white font-sans selection:bg-indigo-500 selection:text-white">
    
    <!-- HERO SECTION -->
    <header class="relative overflow-hidden bg-gradient-to-b from-indigo-950 via-slate-950 to-slate-950 py-24 px-6 text-center border-b border-slate-800/80">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_var(--tw-gradient-stops))] from-indigo-500/10 via-transparent to-transparent pointer-events-none"></div>
      
      <div class="max-w-4xl mx-auto relative z-10">
        <span class="inline-block px-4 py-1.5 rounded-full text-xs font-semibold tracking-wider bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 mb-6 uppercase">
          6 al 8 de Noviembre • Plaza Ñuñoa, Santiago
        </span>
        <h1 class="text-5xl md:text-7xl font-extrabold tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-blue-400 via-emerald-400 to-amber-300 mb-6">
          EXPO REGIÓN ESTRELLA
        </h1>
        <p class="text-xl md:text-2xl text-slate-300 font-light mb-10 max-w-2xl mx-auto leading-relaxed">
          La Región de Coquimbo se levanta y despliega lo mejor de sus valles, costas y emprendimientos.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="#expositores" class="px-8 py-3.5 rounded-xl bg-emerald-500 hover:bg-emerald-600 font-bold transition-all shadow-lg shadow-emerald-500/20 hover:scale-105">
            Explorar Pabellones
          </a>
          <a href="#agenda" class="px-8 py-3.5 rounded-xl bg-slate-900 hover:bg-slate-800 font-semibold border border-slate-700 transition-all hover:border-slate-500">
            Citas B2B (Cal.com)
          </a>
        </div>
      </div>
    </header>

    <!-- MÓDULOS Y EXPOSITORES (SUPABASE) -->
    <section id="expositores" class="max-w-6xl mx-auto px-6 py-20">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Catálogo de Expositores</h2>
        <p class="text-slate-400 max-w-xl mx-auto">Conoce los módulos participantes de la Región de Coquimbo en Plaza Ñuñoa.</p>
      </div>
      
      <div class="grid md:grid-cols-3 gap-8">
        {expositores && expositores.length > 0 ? (
          expositores.map((item) => (
            <div class="bg-slate-900/60 border border-slate-800 hover:border-indigo-500/50 rounded-2xl p-6 backdrop-blur-sm transition-all flex flex-col justify-between group hover:-translate-y-1">
              <div>
                <div class="flex justify-between items-start mb-4">
                  <span class="text-xs font-bold px-3 py-1 rounded-md bg-indigo-500/20 text-indigo-300 border border-indigo-500/30">
                    Módulo #{item.modulo_numero}
                  </span>
                  <span class="text-xs text-emerald-400 font-medium">{item.rubro}</span>
                </div>
                <h3 class="text-xl font-bold mb-2 text-white group-hover:text-indigo-400 transition-colors">{item.nombre}</h3>
                <p class="text-slate-400 text-sm mb-6 leading-relaxed">{item.descripcion}</p>
              </div>
              <a href="#agenda" class="inline-block text-center text-xs font-semibold py-2.5 px-4 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition-all">
                Agendar Cita B2B
              </a>
            </div>
          ))
        ) : (
          <div class="col-span-3 text-center py-12 bg-slate-900/40 rounded-2xl border border-slate-800/60 text-slate-400">
            <p class="text-lg font-medium mb-2">Bienvenido a EXPO REGIÓN ESTRELLA 2026</p>
            <p class="text-sm text-slate-500">Configura la clave anon de Supabase en Cloudflare Pages para listar los módulos en tiempo real.</p>
          </div>
        )}
      </div>
    </section>

  </main>
</Layout>