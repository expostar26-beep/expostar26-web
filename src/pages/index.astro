---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>EXPO REGIÓN ESTRELLA 2026</title>
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>⭐</text></svg>" />
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background-color: #020617;
      color: #f8fafc;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    header {
      background: linear-gradient(180deg, #0f172a 0%, #020617 100%);
      border-bottom: 1px solid #1e293b;
      padding: 4rem 1.5rem;
      text-align: center;
    }
    .badge {
      display: inline-block;
      padding: 0.35rem 1rem;
      border-radius: 9999px;
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      background: rgba(245, 158, 11, 0.1);
      color: #fbbf24;
      border: 1px solid rgba(245, 158, 11, 0.3);
      text-transform: uppercase;
      margin-bottom: 1.5rem;
    }
    h1 {
      font-size: 2.75rem;
      font-weight: 900;
      letter-spacing: -0.025em;
      background: linear-gradient(to right, #fde68a, #fbbf24, #f59e0b);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      text-transform: uppercase;
      margin-bottom: 1rem;
    }
    .hero-desc {
      font-size: 1.125rem;
      color: #94a3b8;
      max-width: 42rem;
      margin: 0 auto 2rem auto;
      line-height: 1.6;
    }
    .btn-group {
      display: flex;
      justify-content: center;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .btn-primary {
      background-color: #f59e0b;
      color: #020617;
      font-weight: 700;
      padding: 0.75rem 1.5rem;
      border-radius: 0.75rem;
      text-decoration: none;
      transition: all 0.2s;
    }
    .btn-primary:hover { background-color: #fbbf24; }
    .btn-secondary {
      background-color: #1e293b;
      color: #e2e8f0;
      font-weight: 600;
      padding: 0.75rem 1.5rem;
      border-radius: 0.75rem;
      text-decoration: none;
      border: 1px solid #334155;
      transition: all 0.2s;
    }
    .btn-secondary:hover { border-color: #f59e0b; background-color: #334155; }
    main {
      flex: 1;
      max-width: 80rem;
      width: 100%;
      margin: 0 auto;
      padding: 3rem 1.5rem;
    }
    .section-title {
      text-align: center;
      margin-bottom: 2.5rem;
    }
    .section-title h2 { font-size: 1.875rem; font-weight: 800; color: #f8fafc; }
    .section-title p { color: #64748b; font-size: 0.875rem; margin-top: 0.5rem; }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 1.5rem;
    }
    .card {
      background-color: rgba(15, 23, 42, 0.8);
      border: 1px solid #1e293b;
      border-radius: 1rem;
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: all 0.3s;
    }
    .card:hover { border-color: rgba(245, 158, 11, 0.5); transform: translateY(-2px); }
    .card-tag {
      font-size: 0.75rem;
      font-weight: 600;
      color: #fbbf24;
      background: rgba(245, 158, 11, 0.1);
      padding: 0.25rem 0.75rem;
      border-radius: 9999px;
      border: 1px solid rgba(245, 158, 11, 0.2);
    }
    .card-mod { font-size: 0.75rem; font-family: monospace; color: #64748b; }
    .card-title { font-size: 1.25rem; font-weight: 700; color: #f1f5f9; margin: 0.75rem 0 0.5rem 0; }
    .card-desc { font-size: 0.875rem; color: #94a3b8; line-height: 1.5; margin-bottom: 1.5rem; }
    .card-footer {
      border-top: 1px solid #1e293b;
      padding-top: 1rem;
      display: flex;
      justify-content: space-between;
      font-size: 0.75rem;
      color: #64748b;
    }
    .status-ok { color: #fbbf24; font-weight: 600; }
    footer {
      border-top: 1px solid #1e293b;
      padding: 2rem;
      text-align: center;
      font-size: 0.75rem;
      color: #475569;
    }
    .chat-widget {
      position: fixed;
      bottom: 1.5rem;
      right: 1.5rem;
      z-index: 50;
    }
    .chat-btn {
      width: 3.5rem;
      height: 3.5rem;
      border-radius: 9999px;
      background: linear-gradient(135deg, #f59e0b, #d97706);
      border: 2px solid #fde68a;
      font-size: 1.5rem;
      cursor: pointer;
      box-shadow: 0 10px 25px -5px rgba(245, 158, 11, 0.4);
      display: flex;
      align-items: center;
      justify-content: center;
    }
  </style>
</head>
<body>

  <header>
    <span class="badge">6 AL 8 DE NOVIEMBRE • PLAZA ÑUÑOA, SANTIAGO</span>
    <h1>EXPO REGIÓN ESTRELLA</h1>
    <p class="hero-desc">La Región de Coquimbo se levanta y despliega lo mejor de sus valles, costas y emprendimientos.</p>
    <div class="btn-group">
      <a href="#catalogo" class="btn-primary">Explorar Pabellones</a>
      <a href="https://cal.com/app" target="_blank" rel="noopener noreferrer" class="btn-secondary">Agendar Citas B2B (Cal.com)</a>
    </div>
  </header>

  <main id="catalogo">
    <div class="section-title">
      <h2>Catálogo de Expositores</h2>
      <p>Conoce los módulos participantes de la Región de Coquimbo en Plaza Ñuñoa.</p>
    </div>

    <div id="expositores-grid" class="grid"></div>
  </main>

  <footer>
    <p>© 2026 EXPO REGIÓN ESTRELLA • Gobierno Regional de Coquimbo</p>
  </footer>

  <div class="chat-widget">
    <button class="chat-btn" title="Asistente Virtual">✨</button>
  </div>

  <script>
    const SUPABASE_URL = "https://crhbfrqfqgxttzyudvt.supabase.co";
    const SUPABASE_ANON_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImNyaGJmcnFmcWd4dHR6eXVkdnQiLCJyb2xlIjoiYW5vbiIsImlhdCI6MTc0MDIxNjI1MywiZXhwIjoyMDU1NzkyMjUzfQ.S8O3S8L94eY1i4i9n6K5O8u3S8L94eY1i4i9n6K5O8u";

    async function loadExhibitors() {
      const grid = document.getElementById('expositores-grid');
      try {
        const client = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
        const { data: expositores, error } = await client.from('expositores').select('*');

        if (error || !expositores || expositores.length === 0) {
          renderFallback();
          return;
        }

        grid.innerHTML = expositores.map(exp => `
          <div class="card">
            <div>
              <div style="display:flex; justify-content:space-between; align-items:center;">
                <span class="card-tag">${exp.pabellon || 'Pabellón Coquimbo'}</span>
                <span class="card-mod">Módulo ${exp.modulo || 'A-01'}</span>
              </div>
              <h3 class="card-title">${exp.nombre}</h3>
              <p class="card-desc">${exp.descripcion || 'Emprendimiento destacado de la Región de Coquimbo.'}</p>
            </div>
            <div class="card-footer">
              <span>📍 ${exp.comuna || 'La Serena / Coquimbo'}</span>
              <span class="status-ok">Módulo Confirmado</span>
            </div>
          </div>
        `).join('');
      } catch (err) {
        renderFallback();
      }
    }

    function renderFallback() {
      const grid = document.getElementById('expositores-grid');
      const MOCK_EXPOSITORES = [
        { nombre: "Pisco Elqui Artesanal", pabellon: "Pisco & Licores", modulo: "A-12", comuna: "Paihuano", descripcion: "Destilados prémium con denominación de origen del Valle del Elqui." },
        { nombre: "Quesos de Majada Ovalle", pabellon: "Agroalimentaria", modulo: "B-05", comuna: "Ovalle", descripcion: "Quesos de cabra madurados con recetas tradicionales del Limarí." },
        { nombre: "Observatorio Astroturismo", pabellon: "Turismo & Astronomía", modulo: "C-01", comuna: "Vicuña", descripcion: "Experiencias de astroturismo bajo los cielos más limpios del planeta." },
        { nombre: "Artesanías en Combarbalita", pabellon: "Artesanía Regional", modulo: "D-08", comuna: "Combarbalá", descripcion: "Piezas únicas talladas en piedra combarbalita nativa." },
        { nombre: "Aceite de Oliva Valle del Huasco/Elqui", pabellon: "Agroalimentaria", modulo: "B-09", comuna: "La Serena", descripcion: "Aceite de oliva extra virgen prensado en frío de alta pureza." },
        { nombre: "Mariscos & Algas Coquimbo", pabellon: "Productos del Mar", modulo: "E-03", comuna: "Coquimbo", descripcion: "Conservas de mariscos y gourmet marino sustentable." }
      ];

      grid.innerHTML = MOCK_EXPOSITORES.map(exp => `
        <div class="card">
          <div>
            <div style="display:flex; justify-content:space-between; align-items:center;">
              <span class="card-tag">${exp.pabellon}</span>
              <span class="card-mod">Módulo ${exp.modulo}</span>
            </div>
            <h3 class="card-title">${exp.nombre}</h3>
            <p class="card-desc">${exp.descripcion}</p>
          </div>
          <div class="card-footer">
            <span>📍 ${exp.comuna}</span>
            <span class="status-ok">Módulo Confirmado</span>
          </div>
        </div>
      `).join('');
    }

    document.addEventListener('DOMContentLoaded', loadExhibitors);
  </script>
</body>
</html>
